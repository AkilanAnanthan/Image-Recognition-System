# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large binary datasets (reproducible via python database/setup_database.py)
data/images/
*.png.bak
*.db
*.sqlite3

# Serialized large model weights (reproducible via training scripts)
models/*.keras
models/*.joblib

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual Environments
venv/
env/
.env

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
